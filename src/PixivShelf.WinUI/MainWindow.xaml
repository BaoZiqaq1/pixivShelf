<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PixivShelf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PixivShelf">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="Notice" Grid.Row="0" IsOpen="False" Severity="Informational" IsClosable="True">
            <InfoBar.ActionButton>
                <Button Content="继续" Click="OnResumePrompt" />
            </InfoBar.ActionButton>
        </InfoBar>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="176"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="下载" Tag="download" Icon="Download" IsSelected="True" />
                <NavigationViewItem Content="任务" Tag="tasks" Icon="AllApps" />
                <NavigationViewItem Content="设置" Tag="settings" Icon="Setting" />
                <NavigationViewItem Content="关于" Tag="about" Icon="Help" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <Border x:Name="LogPane" Grid.Row="2" Visibility="Collapsed" Height="200"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <ListView x:Name="LogList" ItemsSource="{x:Bind LogLines}" Padding="12,6" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0,1" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Border x:Name="ToastHost" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24" Padding="14,10" CornerRadius="8" Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                IsHitTestVisible="False" Opacity="0">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon x:Name="ToastIcon" Glyph="&#xE73E;" FontSize="16"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="ToastText" Text="" VerticalAlignment="Center"
                           MaxWidth="420" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="12,6">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：状态 + 下载速度 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="就绪" Width="48" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="SpeedText" Text="↓0 KB/s" VerticalAlignment="Center"
                               FontSize="12" Opacity="0.55"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               ToolTipService.ToolTip="当前下载速度（只统计图片字节）" />
                </StackPanel>

                <!-- 仅在设置页出现的保存区 -->
                <TextBlock x:Name="DirtyHint" Grid.Column="1" Text="● 未保存" Visibility="Collapsed"
                           VerticalAlignment="Center" FontSize="12" Foreground="#E7C75A" />
                <Button x:Name="SaveButton" Grid.Column="2" Content="保存" Style="{StaticResource AccentButtonStyle}"
                        Visibility="Collapsed" Click="OnSaveSettings" />
                <Border x:Name="SaveSeparator" Grid.Column="3" Width="1" Height="20" Visibility="Collapsed"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <ToggleButton x:Name="LogToggle" Grid.Column="4" Content="日志"
                              Checked="OnToggleLog" Unchecked="OnToggleLog" />
            </Grid>
        </Border>
    </Grid>
</Window>
