<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PixivShelf.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer x:Name="RootScroll" HorizontalContentAlignment="Center" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ContentRoot" Padding="24" Spacing="16" MaxWidth="980" HorizontalAlignment="Center">

            <InfoBar x:Name="SavedBar" IsOpen="False" Severity="Success" Title="已保存" IsClosable="False" />

            <!-- 网络与登录 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="网络与登录" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <!-- 登录 -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Cookie" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <PasswordBox x:Name="CookieBox" Grid.Column="1" Height="36"
                                     VerticalContentAlignment="Center"
                                     PasswordRevealMode="Hidden" FontFamily="Consolas"
                                     PlaceholderText="PHPSESSID 或整条 Cookie"
                                     PasswordChanged="OnAnySettingChanged" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="LoginButton" Content="登录获取" Height="36"
                                    Click="OnLoginWithBrowser" />
                            <Button x:Name="CookieRevealButton" Content="显示" Height="36" MinWidth="64"
                                    Click="OnToggleCookieReveal" />
                            <Button x:Name="CookieClearButton" Content="清除" Height="36" MinWidth="64"
                                    Click="OnClearCookie" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <!-- 网络参数：5 列等宽，标签在上，输入框不带箭头 -->
                    <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="超时（秒）" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <NumberBox x:Name="TimeoutBox" Height="36" HorizontalContentAlignment="Left"
                                           Minimum="3" Maximum="120" SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnNumberChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="重试次数" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <NumberBox x:Name="RetryBox" Height="36" HorizontalContentAlignment="Left"
                                           Minimum="0" Maximum="10" SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnNumberChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Text="重试等待（秒）" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <NumberBox x:Name="RetryWaitBox" Height="36" HorizontalContentAlignment="Left"
                                           Minimum="0" Maximum="60" SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnNumberChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Spacing="6">
                                <TextBlock Text="下载间隔（秒）" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <NumberBox x:Name="DelayBox" Height="36" HorizontalContentAlignment="Left"
                                           Minimum="0" Maximum="60" SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnNumberChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" Spacing="6">
                                <TextBlock Text="并发数（1-8）" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <NumberBox x:Name="WorkersBox" Height="36" HorizontalContentAlignment="Left"
                                           Minimum="1" Maximum="8" SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnNumberChanged" />
                            </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 保存位置与命名 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="保存位置与命名" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RootBox" Grid.Column="0" Header="下载目录" TextChanged="OnAnySettingChanged" />
                        <Button Grid.Column="1" Content="选择文件夹" VerticalAlignment="Bottom" Click="OnBrowseFolder" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="FormatBox" Grid.Column="0" Header="文件名格式"
                                 IsReadOnly="True"
                                 TextChanged="OnAnySettingChanged"
                                 PointerPressed="OnFormatBoxPressed" />

                        <Button x:Name="FormatMenuButton" Grid.Column="1"
                                Height="36" MinWidth="44" VerticalAlignment="Bottom"
                                ToolTipService.ToolTip="选择命名方式"
                                Click="OnFormatMenuClick">
                            <FontIcon x:Name="FormatChevron" Glyph="&#xE70D;"
                                      FontFamily="Segoe MDL2 Assets" FontSize="11"
                                      RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform>
                                    <RotateTransform x:Name="FormatChevronRotate" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 文件时间 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="文件时间" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <RadioButton x:Name="TimePublish" Content="用投稿时间" GroupName="time" Checked="OnTimeChanged" />
                    <RadioButton x:Name="TimeBookmark" Content="用收藏时间（真实月份 + 月内推算）" GroupName="time" Checked="OnTimeChanged" />
                    <ToggleSwitch x:Name="CreationSwitch" Header="修改文件日期"
                                  Toggled="OnCreationToggled" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
