<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PixivShelf.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer x:Name="RootScroll" HorizontalContentAlignment="Center" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ContentRoot" Padding="24" Spacing="16" MaxWidth="820" HorizontalAlignment="Center">

            <!-- 名称与版本 -->
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,8">
                <Image x:Name="AppIcon" Width="64" Height="64" VerticalAlignment="Top" />
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="pixivShelf" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- 简介 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="简介" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" LineHeight="22"
                               Text="pixivShelf 是一个第三方 pixiv 图片下载器，基于开源项目 PixivFetcher 进行重构改进，能够下载你喜欢的作品、你账号的所有收藏。" />
                    <TextBlock TextWrapping="Wrap" LineHeight="22"
                               Text="可能有不少相关的项目了，但这款工具的特点在于能获取你的收藏时间，并应用于本地图片，很适合刷 pixiv 存了很多图、想存在本地又怕找起来不方便的情况（作者自己整理图片人麻了，于是让 AI 大人写了这款软件 2333）。" />
                </StackPanel>
            </Border>

            <!-- 特色功能 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="特色功能" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Spacing="6">
                        <TextBlock TextWrapping="Wrap" Text="· 一次性下载你账号收藏的所有图片" />
                        <TextBlock TextWrapping="Wrap" Text="· 根据你的需求自由调整是否下载成人内容，不怕尴尬" />
                        <TextBlock TextWrapping="Wrap" Text="· 能够把收藏时间写进文件信息" />
                        <TextBlock TextWrapping="Wrap" Text="· 并发下载、支持暂停、断点续传" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 免责声明 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="免责声明" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" LineHeight="22"
                               Text="本工具不是 pixiv 官方客户端，与 pixiv 官方无任何关联，所有作品版权归原作者所有。为了避免封号请合理控制下载频率。" />
                </StackPanel>
            </Border>

            <!-- 其他 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="其他" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="项目地址" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Grid.Row="0" Grid.Column="1" Padding="0" MinHeight="24"
                                         Content="https://github.com/BaoZiqaq1/pixivShelf"
                                         Tag="https://github.com/BaoZiqaq1/pixivShelf"
                                         Click="OnOpenLink" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="作者" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="smile丶luo &amp; DeepSeek"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="特别鸣谢" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="开源项目 PixivFetcher" VerticalAlignment="Center" />
                            <HyperlinkButton Padding="0" MinHeight="24"
                                             Content="https://github.com/Kyy008/PixivFetcher"
                                             Tag="https://github.com/Kyy008/PixivFetcher"
                                             Click="OnOpenLink" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock x:Name="FooterText" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
